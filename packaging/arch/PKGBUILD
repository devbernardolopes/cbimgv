# Maintainer: Bernardo Crivellaro Lopes <bernardocrivellaro@gmail.com>
pkgname=cbimgv
pkgver=0.1.0
pkgrel=1
pkgdesc='Lightweight Qt 6 image viewer for Linux'
arch=('x86_64')
url='https://github.com/devbernardolopes/cbimgv'
license=('Apache-2.0')
depends=('qt6-base')
makedepends=('cmake' 'ninja')
optdepends=('qt6-imageformats: WebP, TIFF and other extra image formats'
            'qt6-svg: SVG image support'
            'qt6-wayland: native Wayland support')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # replace via: updatepkgsums

build() {
  cmake -S "$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}